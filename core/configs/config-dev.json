{
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "max_upload_size_mb": 20,
    "cors_origins": [
      "http://localhost:4200"
    ]
  },
  "store": {
    "ttl_seconds": 3600,
    "max_documents": 100
